<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for API 30 and below (allowBackup / fullBackupContent).

   Everything is excluded. The archive this app produces is a full copy of the
   user's SD card, and app storage must never leave the device via backup.
   See also data_extraction_rules.xml for API 31+.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
