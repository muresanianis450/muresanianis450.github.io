<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
         No storage permissions are declared, and none are needed.

         Reading the card goes entirely through the Storage Access Framework
         (ACTION_OPEN_DOCUMENT_TREE), where the user grants access to one folder
         explicitly. The archive is written to app-private storage, and saving a
         copy goes through ACTION_CREATE_DOCUMENT. MANAGE_EXTERNAL_STORAGE in
         particular was declared but never used, and would have triggered a Play
         policy review for an app that does not qualify for it.

         There is deliberately no INTERNET permission either: the app cannot send
         data anywhere on its own. Sharing hands the file to another app the user
         picks. Keep it that way.
    -->

    <!--
         allowBackup is deliberately false: the archive this app builds is a copy of
         everything on the user's card. Auto Backup would upload it to their Drive and
         adb backup could pull it off the device.
    -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.Light.DarkActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
             The FileProvider that used to live here has been removed. The archive is
             now streamed straight to the document the user picks, so the app never
             holds a copy of their files and has nothing of its own to share out.
             Sharing forwards the grant on that document instead.
        -->

        <!--
             SDCardReceiver was removed here. It was exported with no permission
             guard, so any installed app could forge ACTION_MEDIA_MOUNTED and force
             this activity to the foreground. It also never worked: background
             activity launches are blocked since Android 10, background Toasts since
             Android 12, and USB_DEVICE_ATTACHED is not deliverable to a manifest
             receiver at all. See AUDIT.md #8 for how to reimplement auto-launch
             properly if it is ever wanted.
        -->
    </application>

</manifest>
