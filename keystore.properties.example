# Template for keystore.properties — copy this file to `keystore.properties`
# (same directory) and fill in your real values.
#
#     cp keystore.properties.example keystore.properties
#
# `keystore.properties` is gitignored and must NEVER be committed. This example
# file is committed on purpose, so the required keys are documented.
#
# If keystore.properties is missing, `gradlew assembleRelease` still runs but
# produces app-release-UNSIGNED.apk. That is intentional — it fails loudly rather
# than silently falling back to the debug key. See AUDIT.md #3.

# Path to the .jks file, relative to the app/ module directory.
# If release.jks sits at the repo root, this is correct as written.
storeFile=../release.jks

# The password you set on the keystore itself.
storePassword=CHANGE_ME

# The alias you passed to keytool -alias.
keyAlias=upload

# The password for that key. keytool often uses the same value as storePassword.
keyPassword=CHANGE_ME
